# Mistral AI Configuration
# Get your API key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral Model Selection
# Options: mistral-tiny, mistral-small, mistral-medium, mistral-large-latest
# mistral-tiny: Fastest, cheapest, good for simple tasks
# mistral-small: Balanced performance and cost (RECOMMENDED)
# mistral-medium: Better quality responses
# mistral-large-latest: Best quality, most expensive
MISTRAL_MODEL_ID=mistral-small

# Server Configuration
PORT=5000

# Optional: Set to 'production' in deployed environments
NODE_ENV=development
